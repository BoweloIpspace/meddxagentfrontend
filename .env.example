# Public URL of the MEDDxAgent clinical API.
VITE_MEDDX_API_URL=http://localhost:8000

# Abort clinical API requests that exceed this duration. Values outside
# 5000-600000 ms fall back to the 120000 ms production default.
VITE_MEDDX_REQUEST_TIMEOUT_MS=120000

# Keep local as the default until an authentication provider is connected.
# Set to server only when setMEDDxAccessTokenProvider(...) is wired to a real
# short-lived user access token and the backend auth/database are configured.
VITE_MEDDX_CASE_STORAGE=local
